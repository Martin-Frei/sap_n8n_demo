      "parameters": {
        "jsCode": "function simpleHash(str) {\n    let hash = 0;\n    for (let i = 0; i < str.length; i++) {\n        const char = str.charCodeAt(i);\n        hash = ((hash << 5) - hash) + char;\n        hash = hash & hash;\n    }\n    return Math.abs(hash).toString(16).padStart(8, '0');\n}\n\nreturn $input.all().map(item => ({\n    json: {\n        ...item.json,\n        email_hash: simpleHash(item.json.email),\n        verdict: item.json.verdict || 'normal',\n       claude_verdict: item.json.needs_claude === true && item.json.verdict ? \n    item.json.verdict + ' (' + item.json.confidence + ')' : null,\n        features: JSON.stringify({\n            local_entropy:  item.json.local_entropy,\n            domain_entropy: item.json.domain_entropy,\n            iso_score:      item.json.iso_score,\n            entropy_status: item.json.entropy_status,\n            iso_status:     item.json.iso_status,\n        })\n    }\n}));"
      },
