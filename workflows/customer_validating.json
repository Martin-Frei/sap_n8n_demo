    {
      "parameters": {
        "jsCode": "// Hole die Liste der Bestellungen aus dem SAP-Ergebnis\nconst orders = $input.first().json.d.results;\n\nreturn orders.map(order => {\n    // 1. SAP-Datum in ein echtes, lesbares ISO-Datum umrechnen\n    let isoDate = null;\n    if (order.CreationDate) {\n        const milliSeconds = parseInt(order.CreationDate.replace(/\\/Date\\((\\d+)\\)\\//, '$1'));\n        if (!isNaN(milliSeconds)) {\n            isoDate = new Date(milliSeconds).toISOString();\n        }\n    }\n\n    // 2. Den Hauptkunden (Sold-to Party = 'SP') aus den Partnern heraussuchen\n    const soldToPartner = order.to_Partner?.results?.find(p => p.PartnerFunction === 'SP');\n    const customerId = soldToPartner ? soldToPartner.Customer : (order.SoldToParty || \"Unbekannt\");\n\n    // 3. Sichere Struktur: JEDES Feld existiert IMMER (notfalls als null)\n    return {\n        sales_order: order.SalesOrder || null,\n        order_type: order.SalesOrderType || null,\n        organization: order.SalesOrganization || null,\n        customer_id: customerId || null,\n        net_amount: parseFloat(order.TotalNetAmount) || 0.0, // Wichtig für ML: Immer eine Zahl\n        creation_date: isoDate,\n        currency: order.TransactionCurrency || null,\n        created_by: order.CreatedByUser || null,\n        // Falls der Status leer oder unsichtbar ist, wird er hier zu null -> Struktur bleibt exakt gleich!\n        delivery_status: order.OverallTotalDeliveryStatus || null \n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2048,
        -144
      ],
      "id": "bd7a895c-19f7-4c39-8c37-b4577125b9e2",
      "name": "JS_daten_für_supabase_aubereiten"
    },
    {
      "parameters": {
        "jsCode": "let dbDate = null;\n\ntry {\n  const items = $input.all();\n  if (items && items.length > 0) {\n    // Alle Daten sammeln und das neueste finden\n    const dates = items\n      .map(item => item.json.creation_date)\n      .filter(d => d !== null)\n      .sort();\n    \n    if (dates.length > 0) {\n      dbDate = dates[dates.length - 1]; // letztes = neuestes\n    }\n  }\n} catch (e) {}\n\nlet finalDate;\nif (dbDate) {\n  const nextDay = new Date(dbDate);\n  nextDay.setDate(nextDay.getDate() + 1);\n  finalDate = nextDay.toISOString().split('.')[0];\n} else {\n  finalDate = \"2016-01-01T00:00:00\";\n}\n\nreturn [{\n  json: {\n    sap_filter_date: finalDate\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2272,
        -144
      ],
      "id": "3a909a55-3a92-4ffa-bc2b-062e53fd0f62",
