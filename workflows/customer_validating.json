    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst anomalies = response.anomalies;\n\nconst liste = anomalies.map(a => \n  `Order: ${a.sales_order} | Kunde: ${a.customer_id} | Betrag: ${a.net_amount} USD | Score: ${a.anomaly_score}`\n).join('\\n');\n\nreturn [{\n  json: {\n    model: \"claude-haiku-4-5-20251001\",\n    max_tokens: 1000,\n    messages: [{\n      role: \"user\",\n      content: `Du bist ein Fraud Detection Experte.\nAnalysiere diese ${anomalies.length} auffälligen SAP Sales Orders auf Deutsch:\n\n${liste}\n\nGib für jede Order:\n1. Warum auffällig (1 Satz)\n2. Empfohlene Maßnahme (1 Satz)\n3. Risiko Level: KRITISCH / VERDÄCHTIG / PRÜFEN`\n    }]\n  }\n}];"
      },
